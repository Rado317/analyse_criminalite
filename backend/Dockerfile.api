FROM python:3.12-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
RUN python -m scripts.prepare_artifacts

EXPOSE 8000
CMD ["sh", "-c", "python -m scripts.init_db --force && uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
